{
  "name": "Ethos Data Auto-Update",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "https://your-vercel-app.vercel.app/api/webhook/n8n-update",
        "options": {
          "timeout": 600000
        }
      },
      "id": "webhook-call",
      "name": "Trigger Data Update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "success-check",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "success-check",
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "message": "✅ Ethos data update completed successfully!\n\n📊 Duration: {{ $json.duration }}\n🕐 Timestamp: {{ $json.timestamp }}\n📈 Records: {{ $json.output }}",
        "additionalFields": {}
      },
      "id": "success-notification",
      "name": "Success Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [900, 200]
    },
    {
      "parameters": {
        "message": "❌ Ethos data update failed!\n\n🔍 Error: {{ $json.error }}\n🕐 Timestamp: {{ $json.timestamp }}\n📋 Details: {{ $json.details }}",
        "additionalFields": {}
      },
      "id": "error-notification",
      "name": "Error Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [900, 400]
    },
    {
      "parameters": {
        "url": "https://your-vercel-app.vercel.app/api/current-week",
        "options": {
          "timeout": 30000
        }
      },
      "id": "week-check",
      "name": "Check Current Week",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 500]
    },
    {
      "parameters": {
        "message": "📅 Current Week Status:\n\n🎯 Season: {{ $json.current.season }}\n📆 Week: {{ $json.current.week }}\n⏰ Timestamp: {{ $json.timestamp }}",
        "additionalFields": {}
      },
      "id": "week-notification",
      "name": "Week Status Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [680, 500]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Trigger Data Update",
            "type": "main",
            "index": 0
          },
          {
            "node": "Check Current Week",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Data Update": {
      "main": [
        [
          {
            "node": "Check Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Success": {
      "main": [
        [
          {
            "node": "Success Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Current Week": {
      "main": [
        [
          {
            "node": "Week Status Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 0,
  "updatedAt": "2025-10-24T06:00:00.000Z",
  "versionId": "1"
}
